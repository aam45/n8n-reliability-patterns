{
  "id": "rlpErrorAlert001",
  "name": "02 Fehler-Workflow mit Alarm",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "parameters": {},
      "id": "7c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e01",
      "name": "Fehler in einem Workflow",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// One short line a person can act on: which workflow, which node, what went wrong, where to look.\nconst e = $json;\nconst text = [\n  `n8n-Fehler in \"${e.workflow?.name ?? 'unbekannt'}\"`,\n  `Knoten: ${e.execution?.lastNodeExecuted ?? '-'}`,\n  `Fehler: ${e.execution?.error?.message ?? 'unbekannt'}`,\n  `Ausfuehrung: ${e.execution?.url ?? '-'}`,\n].join('\\n');\nreturn [{ json: { text, workflow: e.workflow?.name ?? null, executionId: e.execution?.id ?? null } }];"
      },
      "id": "7c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e02",
      "name": "Meldung bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, workflow: $json.workflow, executionId: $json.executionId }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "7c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e03",
      "name": "Alarm senden (Slack, Teams, Discord ...)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Fehler in einem Workflow": { "main": [[{ "node": "Meldung bauen", "type": "main", "index": 0 }]] },
    "Meldung bauen": { "main": [[{ "node": "Alarm senden (Slack, Teams, Discord ...)", "type": "main", "index": 0 }]] }
  }
}
